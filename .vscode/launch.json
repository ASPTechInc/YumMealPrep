{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // Runs on the device selected in the status bar (Android emulator or physical device).
      "name": "YumMealPrep (Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      // Ignored on Android; prevents the GTK/Wayland 
      // crash if Linux is the selected device.
      "env": { "GDK_BACKEND": "x11" }
    },
    {
      "name": "YumMealPrep (Linux desktop)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "linux",
      // GTK 3.24.52 on GNOME 50 aborts under 
      // Wayland (missing xsettings 'antialiasing' key); use XWayland.
      "env": { "GDK_BACKEND": "x11" }
    }
  ]
}
