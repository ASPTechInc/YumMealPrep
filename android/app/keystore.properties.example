# Copy this file to android/app/keystore.properties and fill in your keystore details.
# keystore.properties and *.jks files are ignored by Git. Never commit them.
# storeFile can be absolute or relative to android/app/.

storeFile=/path/to/your/release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
